# ===========================================
# CIRCULUS Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database ---
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=generate-a-secure-random-string-here
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- JWT Configuration ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Firebase Cloud Messaging (Push Notifications) ---
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# --- Admin Bootstrap ---
# Used ONLY for initial setup, change immediately after first login
ADMIN_BOOTSTRAP_EMAIL=admin@circulus.app
ADMIN_BOOTSTRAP_PASSWORD=change-this-immediately

# --- Timezone ---
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Competition Settings ---
COMPETITION_WEEK_START_DAY=monday
COMPETITION_RESET_HOUR=0
COMPETITION_RESET_MINUTE=0

# --- Flutter/Mobile Specific ---
# These are used in mobile/.env
FLUTTER_SUPABASE_URL=https://your-project-id.supabase.co
FLUTTER_SUPABASE_ANON_KEY=your-supabase-anon-key
FLUTTER_BACKEND_URL=http://your-local-ip:8000
